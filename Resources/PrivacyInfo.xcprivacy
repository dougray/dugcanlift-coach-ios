<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- No analytics, no ads, no SDKs that track, no account. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!-- Empty because nothing reaches the developer. Coach has no backend: a
	     client's log arrives as a pasted link and stays in SwiftData on this
	     device. Coach makes one kind of request, a street download the coach
	     starts, and it goes to OpenFreeMap, not the developer. It sends the
	     tile coordinates of the area the coach picked (for Coach, the area
	     around a client's route, so roughly where that client runs) and, as
	     any request does, the coach's IP address; it names the area asked for,
	     never a client. A recipe arrives through Safari's share
	     sheet, and a client's route is drawn from files on the device. Nothing
	     about the coach or a client reaches the developer. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- CA92.1: @AppStorage (coachName, coachEmail, cookPlanOwners,
		     recipeWeightUnit) and UserDefaults.standard, read and written by
		     this app only. 1C8F.1: PendingShareLinks, the
		     group.com.dugcanlift.coach suite, where the share extension
		     queues a link for this app to import - read and cleared by the
		     app, written by its own extension, never another developer's. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
				<string>1C8F.1</string>
			</array>
		</dict>
		<!-- Coach's own code reads no file timestamps. Declared to match
		     lift-ios, which links the same LiftKit stack: LiftReference opens
		     its bundled reference databases through GRDB and SQLite, and
		     SwiftData sits on SQLite too; SQLite stats the database files it
		     opens, all inside the app container. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<!-- 35F9.1: MapLibre Native, which draws a client's route over the
		     streets the coach downloaded, measures elapsed time
		     with the system boot time (reason 35F9.1) and reports nothing. Its own
		     manifest says the same; declared here too because the app, not
		     the share extension, is the only bundle that links it. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>35F9.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
